#include <metal_stdlib>
using namespace metal;

struct VSIn3D {
    float3 aPos [[attribute(0)]];
    float3 aNrm [[attribute(1)]];
    float3 aCol [[attribute(2)]];
};

struct VSOut {
    float4 pos [[position]];
    float3 col;
};

struct Uniforms {
    float4x4 mvp;
    float4x4 normal_mat;
    float4   light_dir;   /* xyz = direction, w = ambient */
};

vertex VSOut vs_main(VSIn3D in [[stage_in]],
                     constant Uniforms& u [[buffer(0)]]) {
    VSOut out;
    out.pos = u.mvp * float4(in.aPos, 1.0);

    float3x3 nm = float3x3(u.normal_mat[0].xyz,
                           u.normal_mat[1].xyz,
                           u.normal_mat[2].xyz);
    float3 nrm_ws = normalize(nm * in.aNrm);
    float ndotl = max(dot(nrm_ws, u.light_dir.xyz), 0.0f);
    float ambient = u.light_dir.w;
    out.col = in.aCol * (ndotl + ambient);
    return out;
}
