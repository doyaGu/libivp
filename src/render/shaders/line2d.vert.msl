#include <metal_stdlib>
using namespace metal;
struct VSIn2D { float2 aPos [[attribute(0)]]; float3 aCol [[attribute(1)]]; };
struct VSOut { float4 pos [[position]]; float3 col; };
struct Uniforms { float4x4 proj; };
vertex VSOut vs_main(VSIn2D in [[stage_in]], constant Uniforms& u [[buffer(0)]]) {
    VSOut out;
    out.pos = u.proj * float4(in.aPos, 0.0, 1.0);
    out.col = in.aCol;
    return out;
}
