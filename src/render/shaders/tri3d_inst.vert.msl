#include <metal_stdlib>
using namespace metal;

struct VSIn {
    float3 aPos [[attribute(0)]];
    float3 aNrm [[attribute(1)]];
    float4 iRow0 [[attribute(2)]];
    float4 iRow1 [[attribute(3)]];
    float4 iRow2 [[attribute(4)]];
    float4 iRow3 [[attribute(5)]];
    float4 iCol  [[attribute(6)]];
};

struct VSOut {
    float4 pos [[position]];
    float3 amb;   /* ambient part of the colour */
    float3 dif;   /* diffuse part, attenuated by the shadow */
    float4 sc;    /* xy = shadow map uv, z = light space depth, w = shadows on */
    float  alpha;
};

struct Uniforms {
    float4x4 vp;
    float4   light_dir;   /* xyz = direction towards the light, w = ambient */
    float4x4 light_vp;    /* world -> light clip space, depth in [0,1] */
    float4   shadow;      /* x = 1 when the shadow map is valid */
};

vertex VSOut vs_main(VSIn in [[stage_in]],
                     constant Uniforms& u [[buffer(0)]]) {
    float4x4 model = float4x4(in.iRow0, in.iRow1, in.iRow2, in.iRow3);
    float4 world_pos = model * float4(in.aPos, 1.0);

    VSOut out;
    out.pos = u.vp * world_pos;

    /* cofactor matrix = inverse transpose up to a positive scale, so normals
     * stay correct under non-uniform scaling (cylinders, cones, boxes) */
    float3 c0 = model[0].xyz, c1 = model[1].xyz, c2 = model[2].xyz;
    float3x3 nm = float3x3(cross(c1, c2), cross(c2, c0), cross(c0, c1));
    float3 nrm_ws = normalize(nm * in.aNrm);
    float ndotl = max(dot(nrm_ws, u.light_dir.xyz), 0.0f);
    float ambient = u.light_dir.w * (0.75f - 0.25f * nrm_ws.y);  /* sky (-Y) / ground */
    out.amb = in.iCol.rgb * ambient;
    out.dif = in.iCol.rgb * (0.7f * ndotl);
    out.alpha = in.iCol.a;

    /* shadow lookup position, pushed along the normal against acne */
    float4 lp = u.light_vp * float4(world_pos.xyz + nrm_ws * 0.04f, 1.0f);
    out.sc = float4(lp.x * 0.5f + 0.5f, 0.5f - lp.y * 0.5f, lp.z, u.shadow.x);
    return out;
}
